---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
import heroImage from '../assets/images/hero-home.jpg';
import heroMobileImage from '../assets/images/hero-mobile-bible-study.png';
import bachelorPhoto from '../assets/images/programs/bachelor.jpg';
import mtsPhoto from '../assets/images/programs/mts.jpg';
import mdivPhoto from '../assets/images/programs/mdiv.jpg';
import prestonPhoto from '../assets/images/testimonials/preston-pearce.jpg';
import jeffPhoto from '../assets/images/testimonials/jeff-mooney.jpg';
import raimoPhoto from '../assets/images/testimonials/raimo-survo.jpg';
import eelisPhoto from '../assets/images/testimonials/eelis-halmemies.jpg';
import agricolaPortrait from '../assets/images/about/mikael-agricola.jpg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const news = [
  {
    title: 'ATS Partners with Gateway Seminary',
    meta: "June 9, 2026 — Now offering fully accredited Master's programs.",
  },
  {
    title: 'Seminary Days with Dr. Mooney',
    meta: 'Aug 19–21, 2026',
  },
  {
    title: 'Public Lectures Conference',
    meta: 'Nov 6–7, 2026',
  },
];

const programs = [
  {
    title: 'Bachelor of Theological Studies',
    body: 'This is a 3-4 year degree, with no prior degree required, to prepare men and women for serving in ministry.',
    level: 'Undergraduate',
    photo: bachelorPhoto,
    photoAlt: 'Students in discussion at Agricola Theological Seminary',
  },
  {
    title: 'Master in Theological Studies',
    body: 'This is a 2-3 year degree to prepare men and women ministry in the church.',
    level: 'Graduate',
    photo: mtsPhoto,
    photoAlt: 'Students studying in a classroom at Agricola Theological Seminary',
  },
  {
    title: 'Master of Divinity',
    body: 'This is a 3-4 year degree to prepare men for faithful church planting or/and pastoral ministry.',
    level: 'Graduate',
    photo: mdivPhoto,
    photoAlt: 'Graduates in cap and gown at an Agricola Theological Seminary commencement ceremony',
  },
];

const testimonials = [
  {
    quote:
      "I'm honored to have been involved with ATS since its beginning. I appreciate the rigorous study of Scriptures, sound theology, mentoring, experience in ministry, and the care for students that ATS is intentional to provide.",
    attribution: 'Dr. Preston Pearce',
    photo: prestonPhoto,
  },
  {
    quote:
      'ATS is a unique educational experience. Rooted in a rigorous commitment to the local church, the students read top-tier evangelical scholarship and interact with historical and contemporary ideas. I am always reinvigorated after teaching there.',
    attribution: 'Dr. Jeff Mooney, professor of Old Testament',
    photo: jeffPhoto,
  },
  {
    quote:
      "This seminary has helped me to understand well the overall message of the Bible and to see how the whole Bible is the Word of God. The school was not only focused on increasing theological knowledge but also on the students' character forming in order for them to be serving as pastors wherever they are. I am grateful to the Lord that this seminary exists for the well-being of Christ's Church.",
    attribution: "Raimo Survo, ATS '24 graduate",
    photo: raimoPhoto,
  },
  {
    quote:
      "My studies at ATS have had a significant impact on my own ministry and understanding of God's Word. I can warmly recommend the seminar to anyone who wants to grow both in their holistic understanding of the scriptures and in their communication.",
    attribution: 'Eelis Halmemies, current ATS student',
    photo: eelisPhoto,
  },
];

const spotlightPhotos = await Promise.all(
  testimonials.map((t) => getImage({ src: t.photo, width: 96, height: 96 })),
);

const spotlightData = testimonials.map((t, i) => ({
  quote: t.quote,
  attribution: t.attribution,
  photo: spotlightPhotos[i].src,
}));
---
<Layout
  title="Agricola Theological Seminary | Equipping the next generation of Bible teachers"
  description="Agricola Theological Seminary trains future pastors, teachers, and leaders to understand the Bible deeply and apply it faithfully in real ministry."
>
  <!-- videoId below is Carnegie Mellon's own commercial, used only as a demo placeholder. Swap for real ATS footage before this is ever shown outside this session. -->
  <Hero
    kicker="Join us!"
    headline={`Shaping <span class="hero__highlight">Servants</span> of the <span class="hero__highlight">Word</span> for the <span class="hero__highlight">Church</span> and the World.`}
    primaryCta={{ label: 'Apply now', href: `${base}/apply` }}
    secondaryCta={{ label: 'Learn more', href: `${base}/about` }}
    image={heroImage}
    imageAlt="Agricola Theological Seminary graduates at their commencement ceremony"
    mobileImage={heroMobileImage}
    mobileImageAlt="A small group studying Scripture together"
    videoId="qM43gnigKgQ"
  />

  <section class="news">
    <span class="news__kicker">News</span>
    <h2>Latest News</h2>
    <div class="news__grid">
      {news.map((item, i) => (
        <a class="news__card" href={`${base}/news`}>
          <span class="news__index">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="news__title">{item.title}</h3>
          <p class="news__meta">{item.meta}</p>
          <svg class="news__arrow" width="20" height="12" viewBox="0 0 29 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M27.8039 7.63642C28.1695 7.27091 28.1695 6.67831 27.8039 6.3128L21.8477 0.356543C21.4822 -0.00896263 20.8896 -0.00896263 20.5241 0.356543C20.1586 0.722049 20.1586 1.31465 20.5241 1.68016L25.8185 6.97461L20.5241 12.2691C20.1586 12.6346 20.1586 13.2272 20.5241 13.5927C20.8896 13.9582 21.4822 13.9582 21.8477 13.5927L27.8039 7.63642ZM0 7.91055H27.1421V6.03867H0V7.91055Z" fill="currentColor"/>
          </svg>
        </a>
      ))}
    </div>
    <a class="news__more" href={`${base}/news`}>More News</a>
  </section>

  <section class="programs max-width">
    <span class="programs__kicker">Academic</span>
    <h2>Our Degree Programs</h2>
    <div class="programs__grid">
      {programs.map((program) => (
        <Card
          title={program.title}
          body={program.body}
          level={program.level}
          href={`${base}/programs`}
          image={program.photo}
          imageAlt={program.photoAlt}
        />
      ))}
    </div>
  </section>

  <section class="testimonials max-width">
    <span class="testimonials__kicker">Testimonials</span>
    <h2>What Our Community Says</h2>

    <div class="testimonial-spotlight">
      <img
        class="testimonial-spotlight__photo"
        data-spotlight-photo
        src={spotlightPhotos[0].src}
        alt={testimonials[0].attribution}
        width="96"
        height="96"
      />
      <div class="testimonial-spotlight__content">
        <p class="testimonial-spotlight__quote" data-spotlight-quote>&ldquo;{testimonials[0].quote}&rdquo;</p>
        <p class="testimonial-spotlight__name" data-spotlight-name>{testimonials[0].attribution}</p>
      </div>
    </div>

    <div class="testimonial-grid">
      {testimonials.map((t, i) => (
        <figure class="testimonial-grid__card" data-index={i}>
          <span class="testimonial-grid__mark" aria-hidden="true">&ldquo;</span>
          <blockquote>
            <p class="testimonial-grid__quote">{t.quote}</p>
          </blockquote>
          <figcaption class="testimonial-grid__person">
            <Image src={t.photo} alt={t.attribution} width={30} height={30} class="testimonial-grid__photo" />
            <span class="testimonial-grid__name">{t.attribution}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <script is:inline type="application/json" id="testimonials-data" set:html={JSON.stringify(spotlightData)} />
    <script>
      const dataEl = document.getElementById('testimonials-data');
      if (dataEl && dataEl.textContent) {
        const data = JSON.parse(dataEl.textContent);
        const chosenIndex = Math.floor(Math.random() * data.length);
        const chosen = data[chosenIndex];

        const photoEl = document.querySelector('[data-spotlight-photo]');
        const quoteEl = document.querySelector('[data-spotlight-quote]');
        const nameEl = document.querySelector('[data-spotlight-name]');

        if (photoEl instanceof HTMLImageElement) {
          photoEl.src = chosen.photo;
          photoEl.alt = chosen.attribution;
        }
        if (quoteEl) quoteEl.textContent = `“${chosen.quote}”`;
        if (nameEl) nameEl.textContent = chosen.attribution;

        document.querySelectorAll('.testimonial-grid__card').forEach((card) => {
          const el = card as HTMLElement;
          el.style.display = Number(el.dataset.index) === chosenIndex ? 'none' : '';
        });
      }
    </script>
  </section>

  <section class="pull-quote max-width">
    <a class="pull-quote__aside" href={`${base}/doctrine`}>
      <Image class="pull-quote__photo" src={agricolaPortrait} alt="Portrait of Mikael Agricola by Albert Edelfelt" width={96} height={126} />
      <p class="pull-quote__aside-text">
        Mikael Agricola (c. 1510–1557) studied under Martin Luther in Wittenberg, then translated
        the New Testament into Finnish and became Finland's first Protestant bishop. His legacy
        still shapes our doctrine today.
      </p>
      <span class="pull-quote__aside-link">Read Our Doctrine</span>
    </a>
    <div class="pull-quote__verse">
      <blockquote>
        &ldquo;Let the word of Christ dwell in you richly, teaching and admonishing one another in
        all wisdom, singing psalms and hymns and spiritual songs, with thankfulness in your hearts
        to God.&rdquo;
      </blockquote>
      <cite>Colossians 3:16 (ESV)</cite>
    </div>
  </section>
</Layout>

<style>
  .news {
    max-width: 1480px;
    margin: 0 auto;
    padding: var(--space-5) var(--space-3);
    text-align: center;
  }

  .news__kicker {
    display: block;
    font-family: var(--font-sans);
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #000000;
    margin-bottom: var(--space-2);
  }

  .news h2 {
    font-size: clamp(28px, 4vw, 36px);
    color: #000000;
    margin-bottom: var(--space-4);
  }

  .news__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-3);
    text-align: left;
  }

  .news__card {
    display: block;
    background: rgba(49, 70, 96, 0.06);
    padding: var(--space-4);
    color: inherit;
    text-decoration: none;
    transition: background 0.15s ease;
    position: relative;
  }

  .news__card:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    right: calc(var(--space-4) / -2);
    width: 1px;
    background: var(--color-border);
  }

  .news__card:hover {
    background: rgba(49, 70, 96, 0.1);
  }

  .news__index {
    display: block;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-navy);
    margin-bottom: var(--space-2);
  }

  .news__title {
    font-size: 21px;
    margin-bottom: var(--space-2);
  }

  .news__meta {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-muted);
    margin: 0 0 var(--space-3);
  }

  .news__arrow {
    color: var(--color-navy);
    transition: transform 0.15s ease;
  }

  .news__card:hover .news__arrow {
    transform: translateX(4px);
  }

  .news__more {
    display: block;
    text-align: right;
    color: var(--color-navy);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .news__more:hover {
    color: var(--color-navy-dark);
    text-decoration: underline;
  }

  .programs {
    padding: var(--space-5) var(--space-3);
    text-align: center;
  }

  .programs__kicker {
    display: block;
    font-family: var(--font-sans);
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #000000;
    margin-bottom: var(--space-2);
  }

  .programs h2 {
    font-size: clamp(28px, 4vw, 36px);
    color: #000000;
    margin-bottom: var(--space-4);
  }

  .programs__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .pull-quote {
    display: grid;
    grid-template-columns: minmax(200px, 280px) 1fr;
    gap: var(--space-4);
    align-items: center;
    background: var(--color-white);
    padding: var(--space-5) var(--space-3);
  }

  .pull-quote__aside {
    display: block;
    text-align: center;
    padding-right: var(--space-4);
    border-right: 1px solid var(--color-border);
    color: inherit;
    text-decoration: none;
  }

  .pull-quote__photo {
    width: 84px;
    height: 110px;
    object-fit: cover;
    margin: 0 auto var(--space-2);
    border: 1px solid var(--color-border);
  }

  .pull-quote__aside-text {
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.55;
    color: var(--color-muted);
    margin: 0 0 var(--space-2);
  }

  .pull-quote__aside-link {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-navy);
    border-bottom: 1px solid var(--color-navy);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .pull-quote__aside:hover .pull-quote__aside-link {
    color: var(--color-navy-dark);
    border-color: var(--color-navy-dark);
  }

  .pull-quote__verse {
    text-align: left;
    color: var(--color-ink);
  }

  .pull-quote blockquote {
    font-family: var(--font-serif);
    font-size: clamp(22px, 3vw, 30px);
    line-height: 1.4;
    margin: 0 0 var(--space-2);
  }

  .pull-quote cite {
    font-family: var(--font-sans);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .testimonials {
    padding: var(--space-5) var(--space-3);
  }

  .testimonials__kicker {
    display: block;
    text-align: center;
    font-family: var(--font-sans);
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #000000;
    margin-bottom: var(--space-1);
  }

  .testimonials h2 {
    text-align: center;
    font-size: clamp(28px, 4vw, 36px);
    color: #000000;
    margin-bottom: var(--space-4);
  }

  .testimonial-spotlight {
    position: relative;
    background: var(--color-navy-dark);
    padding: var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    overflow: hidden;
  }

  .testimonial-spotlight::before {
    content: '\201C';
    position: absolute;
    top: -30px;
    left: 12px;
    font-family: var(--font-serif);
    font-size: 160px;
    color: rgba(255, 255, 255, 0.06);
    line-height: 1;
  }

  .testimonial-spotlight__photo {
    position: relative;
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 3px solid rgba(255, 255, 255, 0.25);
  }

  .testimonial-spotlight__content {
    position: relative;
  }

  .testimonial-spotlight__quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 18px;
    line-height: 1.55;
    color: var(--color-white);
    margin: 0 0 var(--space-1);
  }

  .testimonial-spotlight__name {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-white);
    margin: 0;
  }

  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
  }

  .testimonial-grid__card {
    margin: 0;
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border);
    transition: border-color 0.2s ease;
  }

  .testimonial-grid__card:hover {
    border-top-color: var(--color-navy);
  }

  .testimonial-grid__mark {
    display: block;
    font-family: 'Lora', var(--font-serif);
    font-size: 34px;
    line-height: 0.6;
    color: var(--color-navy);
    opacity: 0.15;
    margin-bottom: var(--space-1);
  }

  .testimonial-grid__card blockquote {
    margin: 0 0 var(--space-2);
  }

  .testimonial-grid__person {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .testimonial-grid__photo {
    border-radius: 50%;
    object-fit: cover;
    filter: grayscale(35%);
  }

  .testimonial-grid__name {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    color: var(--color-navy);
    line-height: 1.35;
  }

  .testimonial-grid__quote {
    font-family: 'Lora', var(--font-serif);
    font-style: italic;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--color-ink);
    margin: 0;
  }

  @media (max-width: 640px) {
    .testimonial-spotlight {
      flex-direction: column;
      text-align: center;
    }

    .pull-quote {
      grid-template-columns: 1fr;
    }

    .pull-quote__aside {
      padding-right: 0;
      padding-bottom: var(--space-4);
      border-right: none;
      border-bottom: 1px solid var(--color-border);
      margin-bottom: var(--space-4);
    }

    .pull-quote__verse {
      text-align: center;
    }
  }

</style>
