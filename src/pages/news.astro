---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import grad1 from '../assets/images/about/carousel/graduation-1.jpg';
import grad2 from '../assets/images/about/carousel/graduation-2.jpg';
import grad3 from '../assets/images/about/carousel/graduation-3.jpg';
import grad4 from '../assets/images/about/carousel/graduation-4.jpg';
import grad5 from '../assets/images/about/carousel/graduation-5.jpg';
import faithPhoto from '../assets/images/about/values/faith.jpg';
import historyPhoto from '../assets/images/about/values/history.jpg';

const headerSlides = [
  { image: grad3, alt: 'Graduates on stage at an Agricola Theological Seminary commencement ceremony' },
];

const reels = [
  { url: 'https://www.facebook.com/reel/2236902420151189' },
  { url: 'https://www.facebook.com/reel/1312451249873103' },
];

const reelsPeekLeft = faithPhoto.src;
const reelsPeekRight = historyPhoto.src;

const fbEmbedSrc = (url: string) =>
  `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(url)}&show_text=false&width=300&t=0`;

// Placeholder items — swap in real news/announcements before launch.
const items = [
  {
    title: 'Campus News Headline Goes Here',
    body: 'Placeholder text for a campus news update. Replace this with a real announcement before this page goes live.',
    photo: grad2,
    photoAlt: 'ATS community gathered outdoors',
  },
  {
    title: 'Upcoming Event Headline Goes Here',
    body: 'Placeholder text for an upcoming event. Replace this with real event details before this page goes live.',
    photo: grad1,
    photoAlt: 'ATS community gathered together',
  },
  {
    title: 'Announcement Headline Goes Here',
    body: 'Placeholder text for a general announcement. Replace this with a real announcement before this page goes live.',
    photo: grad4,
    photoAlt: 'Graduates at an Agricola Theological Seminary commencement ceremony, 27 May 2022',
  },
  {
    title: 'Student Life Headline Goes Here',
    body: 'Placeholder text for a student life story. Replace this with a real story before this page goes live.',
    photo: grad5,
    photoAlt: 'Graduates holding certificates in front of the Agricola Theological Seminary crest',
    video: reels,
  },
];

const cameraIcon = '<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/>';
---
<Layout
  title="News | Agricola Theological Seminary"
  description="News, events, and announcements from Agricola Theological Seminary."
>
  <PageHeader
    title="News"
    description="Updates, events, and announcements from Agricola Theological Seminary."
    slides={headerSlides}
  />

  <section class="news-zigzag max-width">
    {items.map((item, i) => (
      <div
        class:list={['news-zigzag__item', 'reveal', { 'news-zigzag__item--reverse': i % 2 === 1 }]}
        style={`--i: ${i}`}
      >
        {item.video ? (
          <div class="news-zigzag__photo-wrap news-zigzag__photo-wrap--reels">
            <button type="button" class="reels-stack reels-stack--prev" aria-label="Show previous video">
              <img class="reels-stack__thumb" src={reelsPeekLeft} alt="" />
              <span class="reels-stack__play" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21 6 3"></polygon></svg>
              </span>
              <span class="reels-stack__label">Previous</span>
            </button>
            <button type="button" class="reels-stack reels-stack--next" aria-label="Show next video">
              <img class="reels-stack__thumb" src={reelsPeekRight} alt="" />
              <span class="reels-stack__play" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21 6 3"></polygon></svg>
              </span>
              <span class="reels-stack__label">Up Next</span>
            </button>
            <div class="reels-card" data-reels={JSON.stringify(item.video)} data-reel-index="0">
              <div class="reels-card__top">
                <span set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${cameraIcon}</svg>`} />
                <span>Reels</span>
              </div>

              <iframe
                class="reels-card__frame"
                src={fbEmbedSrc(item.video[0].url)}
                title="Facebook video"
                loading="lazy"
                allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        ) : (
          <div class="news-zigzag__photo-wrap">
            <div class="news-zigzag__photo-bg" aria-hidden="true"></div>
            <div class="news-zigzag__photo">
              <Image src={item.photo} alt={item.photoAlt} width={700} height={520} />
            </div>
          </div>
        )}
        <div class="news-zigzag__text">
          <h2>{item.title}</h2>
          <p>{item.body}</p>
          {/* TODO: point at the real article once individual news pages exist */}
          <a class="news-zigzag__cta" href="#">Read More</a>

          {item.video && (
            <div class="reels-mobile">
              <div class="reels-mobile__row">
                {item.video.map((reel, reelIndex) => (
                  <div class="reels-mobile__card">
                    <div class="reels-mobile__top">
                      <span set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${cameraIcon}</svg>`} />
                      <span>Reels</span>
                    </div>
                    <img
                      class="reels-mobile__poster"
                      src={reelIndex % 2 === 0 ? reelsPeekLeft : reelsPeekRight}
                      alt=""
                    />
                    <span class="reels-mobile__play" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21 6 3"></polygon></svg>
                    </span>
                    <iframe
                      class="reels-mobile__frame"
                      data-src={fbEmbedSrc(reel.url)}
                      title={`Facebook video ${reelIndex + 1}`}
                      allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
                      allowfullscreen
                    ></iframe>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    ))}
  </section>
</Layout>

<script>
  interface Reel {
    url: string;
  }

  const fbEmbedSrc = (url: string) =>
    `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(url)}&show_text=false&width=300&t=0`;

  document.querySelectorAll<HTMLElement>('.news-zigzag__photo-wrap--reels').forEach((wrap) => {
    const card = wrap.querySelector<HTMLElement>('.reels-card');
    const prevBtn = wrap.querySelector<HTMLButtonElement>('.reels-stack--prev');
    const nextBtn = wrap.querySelector<HTMLButtonElement>('.reels-stack--next');
    const frame = card?.querySelector<HTMLIFrameElement>('.reels-card__frame');
    if (!card || !prevBtn || !nextBtn || !frame) return;

    const reelsData: Reel[] = JSON.parse(card.dataset.reels || '[]');
    if (reelsData.length < 2) {
      prevBtn.style.display = 'none';
      nextBtn.style.display = 'none';
      return;
    }

    const goTo = (targetIndex: number) => {
      const swapOut = card.animate(
        [{ opacity: 1 }, { opacity: 0 }],
        { duration: 200, easing: 'ease', fill: 'forwards' },
      );

      swapOut.addEventListener('finish', () => {
        frame.src = fbEmbedSrc(reelsData[targetIndex].url);
        card.dataset.reelIndex = String(targetIndex);

        card.animate(
          [{ opacity: 0 }, { opacity: 1 }],
          { duration: 250, easing: 'ease', fill: 'forwards' },
        );
      });
    };

    nextBtn.addEventListener('click', () => {
      const currentIndex = Number(card.dataset.reelIndex || '0');
      goTo((currentIndex + 1) % reelsData.length);
    });

    prevBtn.addEventListener('click', () => {
      const currentIndex = Number(card.dataset.reelIndex || '0');
      goTo((currentIndex - 1 + reelsData.length) % reelsData.length);
    });

    let touchStartX = 0;
    let touchStartY = 0;
    let touchActive = false;

    wrap.addEventListener(
      'touchstart',
      (event) => {
        if (event.touches.length !== 1) return;
        touchStartX = event.touches[0].clientX;
        touchStartY = event.touches[0].clientY;
        touchActive = true;
      },
      { passive: true },
    );

    wrap.addEventListener(
      'touchend',
      (event) => {
        if (!touchActive) return;
        touchActive = false;

        const touch = event.changedTouches[0];
        const deltaX = touch.clientX - touchStartX;
        const deltaY = touch.clientY - touchStartY;

        if (Math.abs(deltaX) < 40 || Math.abs(deltaX) < Math.abs(deltaY)) return;

        const currentIndex = Number(card.dataset.reelIndex || '0');
        const targetIndex =
          deltaX < 0
            ? (currentIndex + 1) % reelsData.length
            : (currentIndex - 1 + reelsData.length) % reelsData.length;
        goTo(targetIndex);
      },
      { passive: true },
    );
  });

  document.querySelectorAll<HTMLElement>('.reels-mobile__row').forEach((row) => {
    const cards = Array.from(row.querySelectorAll<HTMLElement>('.reels-mobile__card'));
    const frames = cards.map((c) => c.querySelector<HTMLIFrameElement>('.reels-mobile__frame'));

    const activateOnly = (activeCard: HTMLElement | null) => {
      cards.forEach((card, i) => {
        const frame = frames[i];
        if (!frame) return;
        if (card === activeCard) {
          card.classList.add('is-active');
          if (!frame.getAttribute('src') && frame.dataset.src) {
            frame.setAttribute('src', frame.dataset.src);
          }
        } else {
          card.classList.remove('is-active');
          if (frame.getAttribute('src')) {
            frame.removeAttribute('src');
          }
        }
      });
    };

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        if (!card.classList.contains('is-active')) activateOnly(card);
      });
    });

    activateOnly(cards[0] ?? null);
  });
</script>

<style>
  .news-zigzag {
    padding: var(--space-5) var(--space-3);
    display: flex;
    flex-direction: column;
  }

  .news-zigzag__item {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--space-5);
    align-items: center;
    padding-bottom: var(--space-5);
    margin-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .news-zigzag__item:last-child {
    padding-bottom: 0;
    margin-bottom: 0;
    border-bottom: none;
  }

  .news-zigzag__item--reverse {
    grid-template-columns: 1.4fr 1fr;
  }

  .news-zigzag__item--reverse .news-zigzag__photo-wrap {
    order: 2;
  }

  .news-zigzag__item--reverse .news-zigzag__text {
    order: 1;
  }

  .news-zigzag__photo-wrap {
    position: relative;
  }

  .news-zigzag__photo-bg {
    position: absolute;
    top: 30%;
    bottom: -28px;
    left: -18px;
    right: -18px;
    background: var(--color-navy);
    z-index: 0;
  }

  .news-zigzag__photo {
    position: relative;
    z-index: 1;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .news-zigzag__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .news-zigzag__photo-wrap:hover .news-zigzag__photo img {
    transform: scale(1.04);
  }

  .news-zigzag__photo-wrap--reels {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .reels-stack {
    position: absolute;
    top: 20px;
    left: 50%;
    width: 100%;
    max-width: 300px;
    aspect-ratio: 9 / 16;
    border-radius: 14px;
    overflow: hidden;
    background: linear-gradient(150deg, rgba(var(--color-navy-rgb), 0.1), rgba(var(--color-navy-rgb), 0.02) 65%);
    border: 1px solid rgba(var(--color-navy-rgb), 0.1);
    box-shadow: 0 16px 32px rgba(var(--color-navy-rgb), 0.1);
    padding: 0;
    z-index: 0;
    cursor: pointer;
    font: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .reels-stack--next {
    transform: translateX(calc(-50% + 40px)) scale(0.93) rotate(10deg);
  }

  .reels-stack--next:hover {
    transform: translateX(calc(-50% + 44px)) scale(0.93) rotate(10deg);
    box-shadow: 0 20px 38px rgba(var(--color-navy-rgb), 0.14);
  }

  .reels-stack--prev {
    transform: translateX(calc(-50% - 40px)) scale(0.93) rotate(-10deg);
  }

  .reels-stack--prev:hover {
    transform: translateX(calc(-50% - 44px)) scale(0.93) rotate(-10deg);
    box-shadow: 0 20px 38px rgba(var(--color-navy-rgb), 0.14);
  }

  .reels-stack--prev .reels-stack__label {
    left: auto;
    right: 14px;
  }

  .reels-stack__thumb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.75) saturate(0.9);
  }

  .reels-stack::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.4), transparent 55%);
  }

  .reels-stack__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.4);
    border: 1.5px solid rgba(255, 255, 255, 0.8);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .reels-stack__play svg {
    width: 13px;
    height: 13px;
    margin-left: 2px;
  }

  .reels-stack__label {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 1;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(var(--color-navy-rgb), 0.55);
  }

  .reels-card {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 300px;
    aspect-ratio: 9 / 16;
    border-radius: 14px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.28);
  }

  .reels-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 70px;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.45), transparent);
  }

  .reels-card__frame {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .reels-card__top {
    position: absolute;
    top: 14px;
    left: 14px;
    right: 14px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--color-white);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
  }

  .reels-card__top span:first-child {
    display: inline-flex;
    width: 17px;
    height: 17px;
  }

  .reels-card__top span:first-child svg {
    width: 100%;
    height: 100%;
  }

  .news-zigzag__text h2 {
    font-family: var(--font-serif);
    font-size: clamp(28px, 3.6vw, 40px);
    color: #000000;
    line-height: 1.15;
    margin-bottom: var(--space-2);
  }

  .news-zigzag__text p {
    font-family: var(--font-sans);
    color: var(--color-ink);
    font-size: 16.5px;
    line-height: 1.75;
    margin: 0 0 var(--space-3);
  }

  .news-zigzag__cta {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-navy);
    border: 1px solid var(--color-navy);
    padding: 12px 22px;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .news-zigzag__cta:hover {
    background: var(--color-navy);
    color: var(--color-white);
  }

  .reels-mobile {
    display: none;
  }

  @media (max-width: 860px) {
    .news-zigzag__item,
    .news-zigzag__item--reverse {
      grid-template-columns: 1fr;
    }

    .news-zigzag__item--reverse .news-zigzag__photo-wrap,
    .news-zigzag__item--reverse .news-zigzag__text {
      order: initial;
    }

    .reels-stack,
    .reels-card {
      display: none;
    }

    .news-zigzag__photo-wrap--reels {
      display: block;
    }

    .reels-mobile {
      display: block;
      width: 100%;
      margin-top: var(--space-3);
    }

    .reels-mobile__row {
      display: flex;
      gap: var(--space-2);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: var(--space-2);
      margin: 0 calc(var(--space-3) * -1);
      padding-left: var(--space-3);
      padding-right: var(--space-3);
    }

    .reels-mobile__card {
      position: relative;
      flex: 0 0 auto;
      scroll-snap-align: center;
      width: 150px;
      aspect-ratio: 9 / 16;
      border-radius: 10px;
      overflow: hidden;
      background: #000;
      box-shadow: 0 10px 22px rgba(0, 0, 0, 0.22);
    }

    .reels-mobile__top {
      position: absolute;
      top: 8px;
      left: 8px;
      right: 8px;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 5px;
      color: var(--color-white);
      font-family: var(--font-sans);
      font-size: 10px;
      font-weight: 600;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
    }

    .reels-mobile__top span:first-child {
      display: inline-flex;
      width: 12px;
      height: 12px;
    }

    .reels-mobile__top span:first-child svg {
      width: 100%;
      height: 100%;
    }

    .reels-mobile__frame {
      position: absolute;
      inset: 0;
      z-index: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }

    .reels-mobile__poster {
      position: absolute;
      inset: 0;
      z-index: 1;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: brightness(0.75) saturate(0.9);
      transition: opacity 0.2s ease;
    }

    .reels-mobile__play {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 2;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.4);
      border: 1.5px solid rgba(255, 255, 255, 0.85);
      color: var(--color-white);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: opacity 0.2s ease;
    }

    .reels-mobile__play svg {
      width: 11px;
      height: 11px;
      margin-left: 2px;
    }

    .reels-mobile__card.is-active .reels-mobile__poster,
    .reels-mobile__card.is-active .reels-mobile__play {
      opacity: 0;
      pointer-events: none;
    }
  }
</style>
