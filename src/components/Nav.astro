---
import { Image } from 'astro:assets';
import whiteLogo from '../assets/images/logo-white.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const links = [
  { label: 'About ATS', href: `${base}/about` },
  { label: 'News', href: `${base}/news` },
  { label: 'Doctrine', href: `${base}/doctrine` },
];

const academicLinks = [
  { label: 'Admissions', href: `${base}/admissions` },
  { label: 'Programs', href: `${base}/programs` },
  { label: 'Leadership', href: `${base}/leadership` },
  { label: 'Accredited Partners', href: `${base}/accredited-partners` },
  { label: 'Public Lectures', href: `${base}/public-lectures` },
];
---
<nav class="nav">
  <a class="nav__logo" href={`${base}/`}>
    <Image
      src={whiteLogo}
      alt="Agricola Theological Seminary"
      width={240}
      height={80}
      densities={[1, 2]}
      loading="eager"
      format="png"
    />
  </a>
  <input type="checkbox" id="nav-toggle" class="nav__toggle-checkbox" />
  <label for="nav-toggle" class="nav__hamburger" aria-label="Open menu">&#9776;</label>
  <ul class="nav__links">
    {links.map((link) => (
      <li><a href={link.href}>{link.label}</a></li>
    ))}
    <li class="nav__dropdown">
      <details>
        <summary>Academic</summary>
        <ul class="nav__dropdown-menu">
          {academicLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </details>
    </li>
    <li><a href={`${base}/contact`}>Contact</a></li>
    <li><a class="nav__donate" href={`${base}/donate`}>Donate</a></li>
  </ul>
</nav>

<script>
  const nav = document.querySelector('.nav');
  if (nav) {
    const updateScrolled = () => {
      nav.classList.toggle('nav--scrolled', window.scrollY > 40);
    };
    updateScrolled();
    window.addEventListener('scroll', updateScrolled, { passive: true });
  }
</script>

<style>
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-2) var(--space-3);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    background: linear-gradient(180deg, rgba(var(--color-navy-dark-rgb), 0.85), rgba(var(--color-navy-dark-rgb), 0));
    transition: background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .nav.nav--scrolled {
    background: var(--color-navy-dark);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
  }

  .nav__toggle-checkbox {
    display: none;
  }

  .nav__links {
    display: flex;
    list-style: none;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .nav__links > li > a {
    color: var(--color-white);
    font-family: var(--font-sans);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nav__donate {
    border: 1px solid var(--color-white);
    padding: 8px 16px;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .nav__links > li > a.nav__donate:hover {
    background: var(--color-white);
    color: var(--color-navy);
  }

  .nav__dropdown details > summary {
    cursor: pointer;
    list-style: none;
    color: var(--color-white);
    font-family: var(--font-sans);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nav__dropdown details > summary::-webkit-details-marker {
    display: none;
  }

  .nav__dropdown details > summary::marker {
    content: '';
  }

  .nav__dropdown-menu {
    position: absolute;
    list-style: none;
    background: var(--color-white);
    padding: var(--space-1);
    margin-top: var(--space-1);
    min-width: 180px;
  }

  .nav__dropdown-menu a {
    color: var(--color-navy);
    display: block;
    padding: var(--space-1);
    font-family: var(--font-sans);
    font-size: 12px;
    text-transform: none;
    letter-spacing: normal;
  }

  .nav__hamburger {
    display: none;
    cursor: pointer;
    color: var(--color-white);
    font-size: 22px;
    line-height: 1;
  }

  @media (max-width: 860px) {
    .nav__hamburger {
      display: block;
    }

    .nav__links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--color-navy);
      padding: var(--space-2) var(--space-3);
    }

    .nav__toggle-checkbox:checked ~ .nav__links {
      display: flex;
    }

    .nav__links > li > a {
      display: block;
      padding: var(--space-2) 0;
    }

    .nav__donate {
      display: inline-block;
      margin-top: var(--space-1);
    }

    .nav__dropdown-menu {
      position: static;
      background: none;
      padding: 0 0 0 var(--space-2);
      margin-top: 0;
    }

    .nav__dropdown-menu a {
      color: var(--color-white);
    }
  }
</style>
