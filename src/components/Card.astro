---
interface Props {
  title: string;
  body: string;
}

const { title, body } = Astro.props;
---
<div class="card">
  <h3 class="card__title">{title}</h3>
  <p class="card__body">{body}</p>
</div>

<style>
  .card {
    border: 1px solid rgba(28, 46, 71, 0.15);
    padding: var(--space-3);
  }

  .card__title {
    font-size: 18px;
    margin-bottom: var(--space-1);
  }

  .card__body {
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
  }
</style>
