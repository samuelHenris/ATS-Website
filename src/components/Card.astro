---
interface Props {
  title: string;
  body: string;
  index?: number;
  href?: string;
}

const { title, body, index, href } = Astro.props;
const number = typeof index === 'number' ? String(index).padStart(2, '0') : null;
const Tag = href ? 'a' : 'div';
---
<Tag class="card" href={href}>
  {number && <span class="card__index">{number}</span>}
  <h3 class="card__title">{title}</h3>
  <p class="card__body">{body}</p>
</Tag>

<style>
  .card {
    display: block;
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-navy);
    padding: var(--space-4) var(--space-3) var(--space-3);
    color: inherit;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  a.card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 24px rgba(var(--color-navy-rgb), 0.1);
    border-color: var(--color-navy);
  }

  .card__index {
    display: block;
    font-family: var(--font-serif);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    margin-bottom: var(--space-2);
  }

  .card__title {
    font-size: 20px;
    margin-bottom: var(--space-1);
  }

  .card__body {
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
  }
</style>
