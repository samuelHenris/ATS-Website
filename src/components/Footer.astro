---
import { Image } from 'astro:assets';
import navyLogo from '../assets/images/logo-navy.png';

const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const quickLinks = [
  { label: 'Contact', href: `${base}/contact` },
  { label: 'Programs', href: `${base}/programs` },
  { label: 'Apply', href: `${base}/apply` },
];

const learnMoreLinks = [
  { label: 'About ATS', href: `${base}/about` },
  { label: 'Leadership', href: `${base}/leadership` },
];
---
<footer class="footer">
  <div class="footer__inner max-width">
    <div class="footer__top">
      <Image
        class="footer__logo"
        src={navyLogo}
        alt="Agricola Theological Seminary"
        width={220}
        height={73}
        densities={[1, 2]}
        format="png"
      />
      <div class="footer__columns">
        <div>
          <h3>Quick Links</h3>
          <ul>
            {quickLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h3>Learn More</h3>
          <ul>
            {learnMoreLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      </div>
      <a class="footer__donate" href={`${base}/donate`}>Donate to ATS</a>
    </div>
    <p class="footer__copyright">&copy; {year} Agricola Theological Seminary. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-white);
    border-top: 1px solid var(--color-border);
    padding: var(--space-5) 0 var(--space-3);
  }

  .footer__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-3);
  }

  .footer__logo {
    align-self: center;
  }

  .footer__columns {
    display: flex;
    gap: var(--space-5);
  }

  .footer__donate {
    align-self: center;
  }

  @media (max-width: 640px) {
    .footer__top {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }

    .footer__columns {
      flex-direction: column;
      gap: var(--space-3);
    }
  }

  .footer__columns h3 {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin-bottom: var(--space-1);
  }

  .footer__columns ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer__columns a {
    color: var(--color-navy);
    font-size: 14px;
    line-height: 2;
  }

  .footer__donate {
    display: inline-block;
    background: var(--color-navy);
    color: var(--color-white);
    padding: 12px 24px;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid var(--color-navy);
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .footer__donate:hover {
    background: transparent;
    color: var(--color-navy);
  }

  .footer__copyright {
    color: var(--color-muted);
    font-size: 12px;
    margin: 0;
  }
</style>
