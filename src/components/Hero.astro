---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Cta {
  label: string;
  href: string;
}

interface Props {
  kicker: string;
  headline: string;
  primaryCta: Cta;
  secondaryCta: Cta;
  image: ImageMetadata;
  imageAlt: string;
  videoId?: string;
}

const { kicker, headline, primaryCta, secondaryCta, image, imageAlt, videoId } = Astro.props;
---
<section class="hero">
  <Image class="hero__bg" src={image} alt={imageAlt} width={1920} height={1080} loading="eager" fetchpriority="high" />
  {videoId && (
    <div class="hero__bg-video-wrap" aria-hidden="true">
      <iframe
        class="hero__bg-video"
        src={`https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1&loop=1&playlist=${videoId}&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1&disablekb=1&iv_load_policy=3&fs=0`}
        title=""
        allow="autoplay; encrypted-media"
      ></iframe>
    </div>
  )}
  <div class="hero__scrim"></div>
  <div class="hero__content max-width">
    <span class="hero__kicker">{kicker}</span>
    <h1 class="hero__headline" set:html={headline} />
    <div class="hero__ctas">
      <a class="hero__btn hero__btn--primary" href={primaryCta.href}>{primaryCta.label}</a>
      <a class="hero__btn hero__btn--secondary" href={secondaryCta.href}>{secondaryCta.label}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: clamp(640px, 85vh, 820px);
    display: flex;
    align-items: flex-end;
    background: var(--color-navy);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.35;
  }

  .hero__bg-video-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero__bg-video {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    min-width: 177.78vh;
    min-height: 56.25vw;
    transform: translate(-50%, -50%);
    pointer-events: none;
    border: 0;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(var(--color-navy-dark-rgb), 0.3), rgba(var(--color-navy-dark-rgb), 0.92));
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding: var(--space-5) var(--space-3);
  }

  .hero__kicker {
    display: block;
    font-family: var(--font-sans);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-white);
    opacity: 0.8;
    margin-bottom: var(--space-2);
  }

  .hero__headline {
    color: rgba(255, 255, 255, 0.55);
    font-size: clamp(32px, 5vw, 48px);
    max-width: 720px;
    line-height: 1.1;
    margin-bottom: var(--space-3);
  }

  .hero__headline :global(.hero__highlight) {
    position: relative;
    color: var(--color-white);
    font-weight: 600;
    white-space: nowrap;
  }

  .hero__headline :global(.hero__highlight)::after {
    content: '';
    position: absolute;
    left: -4px;
    right: -4px;
    bottom: -6px;
    height: 10px;
    background: var(--color-white);
    opacity: 0.9;
    border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
    transform: rotate(-1deg);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (max-width: 480px) {
    .hero {
      min-height: 480px;
    }
  }

  .hero__btn {
    font-family: var(--font-sans);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 14px 26px;
    font-weight: 600;
    border: 1px solid transparent;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .hero__btn--primary {
    background: var(--color-white);
    color: var(--color-navy);
  }

  .hero__btn--primary:hover {
    background: transparent;
    color: var(--color-white);
    border-color: rgba(255, 255, 255, 0.55);
  }

  .hero__btn--secondary {
    border: 1px solid rgba(255, 255, 255, 0.55);
    color: var(--color-white);
  }

  .hero__btn--secondary:hover {
    background: var(--color-white);
    color: var(--color-navy);
    border-color: var(--color-white);
  }
</style>
