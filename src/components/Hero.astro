---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Cta {
  label: string;
  href: string;
}

interface Props {
  kicker: string;
  headline: string;
  primaryCta: Cta;
  secondaryCta: Cta;
  image: ImageMetadata;
  imageAlt: string;
  mobileImage?: ImageMetadata;
  mobileImageAlt?: string;
  videoSrc?: string;
}

const {
  kicker,
  headline,
  primaryCta,
  secondaryCta,
  image,
  imageAlt,
  mobileImage,
  mobileImageAlt,
  videoSrc,
} = Astro.props;
---
<section class="hero">
  {!videoSrc && (
    <Image class="hero__bg hero__bg--desktop" src={image} alt={imageAlt} width={1920} height={1080} loading="eager" fetchpriority="high" />
  )}
  {mobileImage && (
    <Image class="hero__bg hero__bg--mobile" src={mobileImage} alt={mobileImageAlt ?? imageAlt} width={960} height={1280} loading="eager" fetchpriority="high" />
  )}
  {videoSrc && (
    <div class="hero__bg-video-wrap" aria-hidden="true">
      <video
        class="hero__bg-video"
        src={videoSrc}
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        oncanplay="this.parentElement.classList.add('is-loaded')"
      ></video>
    </div>
  )}
  <div class="hero__content max-width">
    <span class="hero__kicker">{kicker}</span>
    <h1 class="hero__headline" set:html={headline} />
    <div class="hero__ctas">
      <a class="hero__btn hero__btn--primary" href={primaryCta.href}>{primaryCta.label}</a>
      <a class="hero__btn hero__btn--secondary" href={secondaryCta.href}>{secondaryCta.label}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: clamp(640px, 85vh, 820px);
    display: flex;
    align-items: flex-end;
    background: var(--color-navy);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__bg--mobile {
    display: none;
  }

  .hero__bg-video-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background-image: linear-gradient(
      100deg,
      rgba(255, 255, 255, 0.04) 25%,
      rgba(255, 255, 255, 0.12) 37%,
      rgba(255, 255, 255, 0.04) 50%
    );
    background-size: 400% 100%;
    animation: hero-video-shimmer 1.6s ease-in-out infinite;
  }

  .hero__bg-video-wrap.is-loaded {
    animation: none;
    background-image: none;
  }

  @keyframes hero-video-shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__bg-video-wrap {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .hero__bg-video-wrap {
      display: none;
    }

    .hero__bg--desktop {
      display: none;
    }

    .hero__bg--mobile {
      display: block;
    }
  }

  .hero__bg-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    border: 0;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding: var(--space-5) var(--space-3);
  }

  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-fade-up-kicker {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 0.8;
      transform: translateY(0);
    }
  }

  .hero__kicker,
  .hero__headline,
  .hero__ctas {
    opacity: 0;
    animation: hero-fade-up 1.1s ease forwards;
  }

  .hero__kicker {
    animation-name: hero-fade-up-kicker;
    animation-delay: 0.15s;
  }

  .hero__headline {
    animation-delay: 0.35s;
  }

  .hero__ctas {
    animation-delay: 0.6s;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__kicker,
    .hero__headline,
    .hero__ctas {
      animation: none;
      opacity: 1;
    }

    .hero__kicker {
      opacity: 0.8;
    }
  }

  .hero__kicker {
    display: block;
    font-family: var(--font-sans);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-white);
    opacity: 0.8;
    margin-bottom: var(--space-2);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6);
  }

  .hero__headline {
    color: rgba(255, 255, 255, 0.55);
    font-size: clamp(32px, 5vw, 48px);
    max-width: 720px;
    line-height: 1.1;
    margin-bottom: var(--space-3);
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.6);
  }

  .hero__headline :global(.hero__highlight) {
    position: relative;
    color: var(--color-white);
    font-weight: 600;
    white-space: nowrap;
  }

  .hero__headline :global(.hero__highlight)::after {
    content: '';
    position: absolute;
    left: -4px;
    right: -4px;
    bottom: -6px;
    height: 10px;
    background: var(--color-white);
    opacity: 0.9;
    border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
    transform: rotate(-1deg);
  }

  @media (max-width: 640px) {
    .hero__headline {
      line-height: 1.8;
    }

    .hero__headline :global(.hero__highlight)::after {
      display: none;
    }
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (max-width: 480px) {
    .hero {
      min-height: 480px;
    }
  }

  .hero__btn {
    font-family: var(--font-sans);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 14px 26px;
    font-weight: 600;
    border: 1px solid transparent;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .hero__btn--primary {
    background: var(--color-white);
    color: var(--color-navy);
  }

  .hero__btn--primary:hover {
    background: transparent;
    color: var(--color-white);
    border-color: rgba(255, 255, 255, 0.55);
  }

  .hero__btn--secondary {
    border: 1px solid rgba(255, 255, 255, 0.7);
    background: rgba(0, 0, 0, 0.25);
    color: var(--color-white);
  }

  .hero__btn--secondary:hover {
    background: var(--color-white);
    color: var(--color-navy);
    border-color: var(--color-white);
  }
</style>
