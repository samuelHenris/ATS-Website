---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Cta {
  label: string;
  href: string;
}

interface Props {
  kicker: string;
  headline: string;
  primaryCta: Cta;
  secondaryCta: Cta;
  image: ImageMetadata;
  imageAlt: string;
}

const { kicker, headline, primaryCta, secondaryCta, image, imageAlt } = Astro.props;
---
<section class="hero">
  <Image class="hero__bg" src={image} alt={imageAlt} width={1920} height={1080} loading="eager" fetchpriority="high" />
  <div class="hero__scrim"></div>
  <div class="hero__content max-width">
    <span class="hero__kicker">{kicker}</span>
    <h1 class="hero__headline">{headline}</h1>
    <div class="hero__ctas">
      <a class="hero__btn hero__btn--primary" href={primaryCta.href}>{primaryCta.label}</a>
      <a class="hero__btn hero__btn--secondary" href={secondaryCta.href}>{secondaryCta.label}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 640px;
    display: flex;
    align-items: flex-end;
    background: var(--color-navy);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.35;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(var(--color-navy-dark-rgb), 0.3), rgba(var(--color-navy-dark-rgb), 0.92));
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding: var(--space-5) var(--space-3);
  }

  .hero__kicker {
    display: block;
    font-family: var(--font-sans);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-white);
    opacity: 0.8;
    margin-bottom: var(--space-2);
  }

  .hero__headline {
    color: var(--color-white);
    font-size: clamp(32px, 5vw, 48px);
    max-width: 720px;
    line-height: 1.1;
    margin-bottom: var(--space-3);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (max-width: 480px) {
    .hero {
      min-height: 480px;
    }
  }

  .hero__btn {
    font-family: var(--font-sans);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 14px 26px;
    font-weight: 600;
    border: 1px solid transparent;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .hero__btn--primary {
    background: var(--color-white);
    color: var(--color-navy);
  }

  .hero__btn--primary:hover {
    background: transparent;
    color: var(--color-white);
    border-color: rgba(255, 255, 255, 0.55);
  }

  .hero__btn--secondary {
    border: 1px solid rgba(255, 255, 255, 0.55);
    color: var(--color-white);
  }

  .hero__btn--secondary:hover {
    background: var(--color-white);
    color: var(--color-navy);
    border-color: var(--color-white);
  }
</style>
